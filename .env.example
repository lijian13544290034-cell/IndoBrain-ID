# Choose one: openai | gemini | openrouter | groq | deepseek | qwen
AI_PROVIDER=
AI_MODEL=
FAST_MODEL=google/gemini-2.5-flash-lite
SMART_MODEL=google/gemini-2.5-flash
STT_MODEL=openai/gpt-4o-mini-transcribe

OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Either Supabase key name is supported. Use only a non-production value locally.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Server-side only. Required for Super Admin batch student imports and password resets.
# Use a value that meets the password policy (10+ characters with letters and numbers).
INITIAL_STUDENT_PASSWORD=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Achievement card referral links. Keep secrets server-side only.
REFERRAL_QR_BASE_URL=
REFERRAL_LANDING_URL=
REFERRAL_SIGNING_SECRET=
REFERRAL_COOKIE_MAX_AGE_SECONDS=2592000
