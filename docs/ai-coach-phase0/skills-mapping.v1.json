    },
    {
      "skillId": "S03",
      "englishName": "Scaffolding",
      "chineseName": "支架",
      "definition": "用户卡住时，用最小必要帮助把他推到“自己说出来”，而不是替他说话。支架的价值在于被撤除；无法撤除的支架是失败的支架。",
      "sourceId": "WBA-SKILLS-S01-S12",
      "sourceLocator": "received/original/WA/1-IndoBrain-AI-Teaching-Skills-V1.md:217-220",
      "extractionStatus": "EXTRACTED_PENDING_HUMAN_REVIEW",
      "notes": []
    },
    {
      "skillId": "S04",
      "englishName": "Adaptive Difficulty",
      "chineseName": "自适应难度",
      "definition": "把难度稳定维持在“跳一跳够得着”的区间：太简单则无聊且不产生习得，太难则挫败且不产生输出。难度调节的颗粒度是“一次一个信息点”，不是“整课升降级”。",
      "sourceId": "WBA-SKILLS-S01-S12",
      "sourceLocator": "received/original/WA/1-IndoBrain-AI-Teaching-Skills-V1.md:320-323",
      "extractionStatus": "EXTRACTED_PENDING_HUMAN_REVIEW",
      "notes": []
    },
    {
      "skillId": "S05",
      "englishName": "Corrective Feedback",
      "chineseName": "纠错反馈",
      "definition": "在不打断表达意愿的前提下，让用户注意到错误并立即再试一次。纠错的目标是“改一次”，不是“讲明白为什么”。",
      "sourceId": "WBA-SKILLS-S01-S12",
      "sourceLocator": "received/original/WA/1-IndoBrain-AI-Teaching-Skills-V1.md:414-417",
      "extractionStatus": "EXTRACTED_PENDING_HUMAN_REVIEW",
      "notes": []
    },
    {
