{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indobrain.app/schemas/mandarin-course-import-v1.schema.json",
  "title": "IndoBrain ID_TO_ZH Supplemental Course Import V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "direction", "contentType", "reviewStatus", "reviewReference", "course", "expressions"],
  "properties": {
    "version": { "const": 1 },
    "direction": { "const": "ID_TO_ZH" },
    "contentType": { "enum": ["PUBLIC_HIGH_FREQUENCY", "CAREER_SCENARIO"] },
    "reviewStatus": { "const": "HUMAN_APPROVED" },
    "reviewReference": { "type": "string", "minLength": 1 },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titleZh", "titleId", "groupId", "scenarioId", "accessTier", "requiresPermission", "pathway"],
      "properties": {
        "id": { "type": "string" },
        "titleZh": { "type": "string", "minLength": 1 },
        "titleId": { "type": "string", "minLength": 1 },
        "groupId": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "minLength": 1 },
        "accessTier": { "enum": ["FREE", "LEVEL_2"] },
        "requiresPermission": { "type": ["string", "null"] },
        "pathway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "recommendedAfterLessonId", "prerequisiteLessonIds"],
          "properties": {
            "mode": { "const": "SUPPLEMENTAL" },
            "recommendedAfterLessonId": { "type": ["string", "null"] },
            "prerequisiteLessonIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      }
    },
    "expressions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "chinese", "pinyin", "indonesian", "ttsText", "difficulty", "tags"],
        "properties": {
          "id": { "type": "string" },
          "chinese": { "type": "string", "minLength": 1 },
          "pinyin": { "type": "string", "minLength": 1 },
          "indonesian": { "type": "string", "minLength": 1 },
          "ttsText": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": [1, 2, 3] },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
